else
  export NODE_PATH="/workspace/node_modules/.pnpm/vitest@4.1.10_@types+node@26.2.0_happy-dom@20.11.2_vite@6.4.3_@types+node@26.2.0_lightningcss@1.33.0_tsx@4.23.12_/node_modules/vitest/node_modules:/workspace/node_modules/.pnpm/vitest@4.1.10_@types+node@26.2.0_happy-dom@20.11.2_vite@6.4.3_@types+node@26.2.0_lightningcss@1.33.0_tsx@4.23.12_/node_modules:/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../vitest/vitest.mjs" "$@"
fi
