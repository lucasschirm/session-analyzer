{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PROJECT_DIR\"/.devin/hooks/sync-agents-symlinks.sh",
          "timeout": 15,
          "statusMessage": "Syncing .agents/ symlinks"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PROJECT_DIR\"/.devin/hooks/block-precommit-bypass.mjs",
          "timeout": 5,
          "statusMessage": "Checking for pre-commit bypass"
        }
      ]
    }
  ]
}
