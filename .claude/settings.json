{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-agents-symlinks.sh",
            "timeout": 15,
            "statusMessage": "Syncing .agents/ symlinks"
          }
        ]
      }
    ]
  },
  "marketplaces": {
    "session-analyzer": {
      "source": "github",
      "repo": "lucasschirm/session-analyzer"
    }
  },
  "enabledPlugins": {
    "claude-session-sync@session-analyzer": true
  },
  "env": {
    "SAL_PROJECT_ID": "session-analyzer"
  }
}
