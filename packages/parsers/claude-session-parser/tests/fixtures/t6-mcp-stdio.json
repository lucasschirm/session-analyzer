{
  "mcpServers": {
    "vuetify:mcp": {
      "command": "pnpm",
      "args": ["vuetify:mcp"]
    },
    "demo:mcp": {
      "command": "node",
      "args": ["tools/demo-mcp.js"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "claude-in-chrome": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/claude-in-chrome-mcp"]
    },
    "pep:mcp": {
      "command": "node",
      "args": ["tools/pep-mcp/dist/index.js"],
      "env": {
        "PEP_ENV": "dev"
      }
    }
  }
}
