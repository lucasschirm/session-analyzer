{
  "name": "@lucasschirm/sal-devin-session-parser",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "ISC",
  "description": "Pure, dependency-free parser for Devin CLI session transcripts (devin-session-jsonl/v1), ATIF v1.7 native transcripts, models.json, and schema-descriptor.json.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasschirm/session-analyzer.git",
    "directory": "packages/parsers/devin-session-parser"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check src",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "version:patch": "exit 0",
    "version:publish": "exit 0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
