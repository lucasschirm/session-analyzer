{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@workers/*": ["./src/workers/*"],
      "@db/*": ["./src/db/*"],
      "@types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../db-core/tests/conformance/**/*.ts"],
  "exclude": ["node_modules"]
}
