{
  "name": "@lucasschirm/sal-transformer-shared",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "description": "Harness-agnostic session transformer contract layer, registry, and conformance suite.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasschirm/session-analyzer.git",
    "directory": "packages/transformers/transformer-shared"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check src tests",
    "preverify": "pnpm run build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "version:patch": "exit 0",
    "version:publish": "exit 0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
