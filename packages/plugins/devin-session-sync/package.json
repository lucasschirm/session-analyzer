{
  "name": "@lucasschirm/devin-session-sync",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "ISC",
  "description": "Devin CLI plugin adapter for the @lucasschirm/sal-sync session data sync engine (SQLite->JSONL extractor; plugin manifest/hooks/CLI land in DS-F3).",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasschirm/session-analyzer.git",
    "directory": "packages/plugins/devin-session-sync"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "package.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src tests build.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "version:patch": "exit 0",
    "version:publish": "exit 0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
