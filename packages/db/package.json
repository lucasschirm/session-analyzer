{
  "name": "@lucasschirm/sal-db",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "description": "Application-facing analytics ingestion and data-source facade.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasschirm/session-analyzer.git",
    "directory": "packages/db"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src tests",
    "preverify": "pnpm run build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "version:patch": "exit 0",
    "version:publish": "exit 0"
  },
  "dependencies": {
    "@lucasschirm/sal-db-core": "workspace:*",
    "@lucasschirm/sal-sync-core": "workspace:*",
    "@lucasschirm/sal-transformer": "workspace:*"
  },
  "devDependencies": {
    "@lucasschirm/claude-session-sync": "workspace:*",
    "@lucasschirm/sal-sync": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
