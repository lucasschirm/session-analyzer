{
  "name": "session-analyzer",
  "version": "1.0.1",
  "private": true,
  "description": "Offline Agentic Session Dashboard - Visualize and manage AI coding sessions",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "dev": "pnpm --filter site dev",
    "preview": "pnpm --filter site preview",
    "test": "pnpm --filter site test",
    "test:coverage": "pnpm --filter site test:coverage",
    "test:watch": "pnpm --filter site test:watch",
    "test:e2e": "pnpm --filter site test:e2e",
    "test:e2e:ui": "pnpm --filter site test:e2e:ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm -r build && pnpm -r run verify",
    "analytics-gates": "node scripts/analytics-gates/run-all-gates.mjs",
    "version:patch": "pnpm -r version:patch",
    "prepare": "husky",
    "version:publish": "pnpm -r version:publish"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
